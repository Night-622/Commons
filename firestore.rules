rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function docPath(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    // Where a player's plot pointer lives: users/{uid} for the public world, memberships/{uid}_{world} otherwise.
    // Admins are listed in admins/{uid}; create that document by hand in the console.
    function isAdmin() { return signedIn() && exists(docPath('admins', me())); }
    // Open worlds everyone can join: the classic ones and each fresh start (s2, s3, ...), so a reset needs no new rules.
    function openWorld(w) { return w.matches('^(public|main|s[0-9]+)$'); }
    function nameOk(d) { return (!('ownerName' in d) || (d.ownerName is string && d.ownerName.size() <= 24)) && (!('name' in d) || (d.name is string && d.name.size() <= 40)); }
    function linkPath(world) { return world == 'public' ? docPath('users', me()) : docPath('memberships', me() + '_' + world); }
    // Every write to a plot is stamped with the server's clock, so the limits below can trust the time between saves.
    function stamped(d) { return d.updatedAt == request.time; }
    function counts(d) { return d.money is number && d.pop is number && d.peakPop is number && d.day is number; }
    // A fresh city: the starting money (or a rebuild's, plus half of what a mover brings), a handful of settlers, day 0.
    function freshCity(d, maxMoney) { return counts(d) && d.money <= maxMoney && d.pop <= 12 && d.peakPop <= 12 && d.day <= 1; }
    // Between two saves a city can't grow faster than a busy city could: a flat allowance plus a rate per second.
    // A city day is 60 real seconds and there is no speed-up, so days can't pass faster than that.
    function riseOk(after, before) {
      let secs = before.get('updatedAt', null) is timestamp ? (request.time.toMillis() - before.updatedAt.toMillis()) / 1000 : 0;
      return counts(after)
        && after.money <= before.get('money', 0) + 10000 + secs * 100
        && after.pop <= before.get('pop', 0) + 200 + secs
        && after.peakPop <= before.get('peakPop', 0) + 200 + secs
        && after.day <= before.get('day', 0) + 2 + secs / 60;
    }
    // A council's list of cities: at most 9, only ever grows by one at a time, and the newest must be yours.
    function citiesOk(after, before) {
      let ids = after.get('plotIds', []);
      let old = before.get('plotIds', [before.plotId]);
      return !('plotIds' in after) || (ids is list && ids.size() <= 9 && ids.size() <= old.size() + 1 && ids.hasAll(old)
        && (ids.size() == old.size() || getAfter(docPath('plots', ids[ids.size() - 1])).data.owner == me()));
    }
    // Buying the plot next to one of your cities: via names that city, which must be yours and touch the new plot.
    function boughtNextTo(d, plotId) {
      let w = d.world;
      let x = d.px;
      let y = d.py;
      return exists(linkPath(w)) && d.via is string
        && d.via in [w + '_' + string(x + 1) + '_' + string(y), w + '_' + string(x - 1) + '_' + string(y), w + '_' + string(x) + '_' + string(y + 1), w + '_' + string(x) + '_' + string(y - 1)]
        && get(docPath('plots', d.via)).data.owner == me()
        && plotId in getAfter(linkPath(w)).data.plotIds;
    }
    // Up to 3 co-mayors, never the owner themselves.
    function coOk(d) { return !('co' in d) || (d.co is list && d.co.size() <= 3 && !(d.owner in d.co)); }
    function runs(plot) { return plot.owner == me() || me() in plot.get('co', []); }
    // Moving onto ruins keeps half the money of the city being left (see MOVE_KEEP and REBUILD_MONEY).
    function rebuildMoney(world) {
      return 3500 + (exists(linkPath(world)) ? get(docPath('plots', get(linkPath(world)).data.plotId)).data.get('money', 0) / 2 : 0);
    }

    // Public world: which plot each player owns. Can only be repointed at a plot they now own (moving).
    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['plotId', 'createdAt']);
      allow update: if signedIn() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plotId', 'plotIds'])
        && getAfter(docPath('plots', request.resource.data.plotId)).data.owner == me()
        && citiesOk(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Private worlds: one membership per player per world.
    match /memberships/{mid} {
      allow get: if signedIn() && mid.matches(me() + '_.+');
      allow list: if signedIn() && resource.data.uid == me();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'world', 'plotId', 'createdAt'])
        && request.resource.data.uid == me()
        && mid == me() + '_' + request.resource.data.world
        && getAfter(docPath('plots', request.resource.data.plotId)).data.owner == me();
      allow update: if signedIn() && resource.data.uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plotId', 'plotIds'])
        && getAfter(docPath('plots', request.resource.data.plotId)).data.owner == me()
        && citiesOk(request.resource.data, resource.data);
      allow delete: if false;
    }

    // Worlds and their plot counters. The counter can only ever go up by one.
    match /worlds/{worldId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        (openWorld(worldId) && request.resource.data.keys().hasOnly(['nextIndex']) && request.resource.data.nextIndex == 1)
        || (!openWorld(worldId)
          && request.resource.data.keys().hasOnly(['name', 'owner', 'code', 'private', 'nextIndex', 'createdAt'])
          && request.resource.data.owner == me()
          && request.resource.data.nextIndex == 0
          && request.resource.data.name is string && request.resource.data.name.size() <= 40));
      allow update: if signedIn() && (
        // The frontier counter only moves forward: by one, or past slots someone already bought (up to 30).
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextIndex'])
          && request.resource.data.nextIndex > resource.data.nextIndex && request.resource.data.nextIndex <= resource.data.nextIndex + 30)
        // The world's creator can rename it.
        || (resource.data.owner == me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40));
      allow delete: if false;
    }

    // Invite codes for private worlds.
    match /worldCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['world'])
        && getAfter(docPath('worlds', request.resource.data.world)).data.code == code
        && getAfter(docPath('worlds', request.resource.data.world)).data.owner == me();
      allow update, delete: if false;
    }

    // Everyone can see every plot; only the owner can change theirs,
    // except that anyone may start a new city on ruins (the rubble stays).
    match /plots/{plotId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner == me()
        && plotId == request.resource.data.world + '_' + string(request.resource.data.px) + '_' + string(request.resource.data.py)
        && ((!exists(linkPath(request.resource.data.world)) && getAfter(linkPath(request.resource.data.world)).data.plotId == plotId)
          || boughtNextTo(request.resource.data, plotId))
        && !('state' in request.resource.data)
        && nameOk(request.resource.data)
        && stamped(request.resource.data)
        && freshCity(request.resource.data, 3000);
      allow update: if signedIn()
        && request.resource.data.world == resource.data.world
        && request.resource.data.px == resource.data.px
        && request.resource.data.py == resource.data.py
        && (!('state' in request.resource.data) || request.resource.data.state.size() < 200000)
        && nameOk(request.resource.data)
        && stamped(request.resource.data)
        && (
          // The owner saving. Money, people and days can't jump faster than a busy city could manage (a cheap
          // guard against edits). The flat allowance covers undo refunds, goal rewards and grants in the same save.
          (resource.data.owner == me() && request.resource.data.owner == me()
            && riseOk(request.resource.data, resource.data)
            && coOk(request.resource.data))
          // A co-mayor at the desk saves like the owner, but can't change who owns or co-runs it, except to leave.
          || (me() in resource.data.get('co', []) && request.resource.data.owner == resource.data.owner
            && riseOk(request.resource.data, resource.data)
            && (request.resource.data.get('co', []) == resource.data.get('co', [])
              || request.resource.data.get('co', []).toSet() == resource.data.get('co', []).toSet().difference([me()].toSet())))
          || (resource.data.status == 'ruins'
            && request.resource.data.owner == me()
            && getAfter(linkPath(resource.data.world)).data.plotId == plotId
            && freshCity(request.resource.data, rebuildMoney(resource.data.world)))
        );
      allow delete: if false;
    }

    // The full save for each plot. Anyone can read it; only the plot's owner can write it.
    match /plotState/{plotId} {
      allow read: if signedIn();
      // Only in the same write as the plot's summary, so the summary's limits apply to it too.
      allow create, update: if signedIn()
        && runs(getAfter(docPath('plots', plotId)).data)
        && getAfter(docPath('plots', plotId)).data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['state'])
        && request.resource.data.state is string && request.resource.data.state.size() < 900000;
      allow delete: if false;
    }

    // The market. Anyone can read open offers; only a city's mayors post for it; only someone else takes an offer,
    // and only the owner cancels an open one.
    match /worlds/{worldId}/offers/{offerId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'res', 'qty', 'price', 'total', 'repay', 'days', 'edu', 'owner', 'ownerName', 'plot', 'city', 'status', 'createdAt'])
        && request.resource.data.owner == me() && runs(get(docPath('plots', request.resource.data.plot)).data)
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time
        && request.resource.data.kind in ['sell', 'buy', 'loan', 'labour']
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total <= 250000
        && request.resource.data.qty is int && request.resource.data.qty >= 0 && request.resource.data.qty <= 5000
        && request.resource.data.get('repay', 0) is number && request.resource.data.get('repay', 0) <= request.resource.data.total * 2 + 1
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 24
        && request.resource.data.city is string && request.resource.data.city.size() <= 40;
      allow update: if signedIn() && (
        (resource.data.status == 'open' && resource.data.owner != me()
          && request.resource.data.status == 'taken' && request.resource.data.takenBy == me() && request.resource.data.takenAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'takenBy', 'takenPlot', 'takenName', 'takenAt']))
        || (resource.data.owner == me() && resource.data.status == 'open' && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      allow delete: if signedIn() && ((resource.data.owner == me() && resource.data.status != 'open') || isAdmin());
    }
    // Deals: money or goods on their way. Only between the two sides of one offer: the taker pays, delivers or lends
    // (up to the offer's total), and a borrower repays their lender (up to the agreed amount).
    function dealOk(o, d) {
      return (o.get('takenBy', '') == me() && d.toOwner == o.owner && d.money <= o.total && d.qty <= o.qty)
        || (o.owner == me() && o.kind == 'loan' && d.toOwner == o.get('takenBy', '') && d.money <= o.get('repay', 0) && d.qty == 0);
    }
    match /worlds/{worldId}/deals/{dealId} {
      allow get: if signedIn() && (resource.data.toOwner == me() || resource.data.from == me());
      allow list: if signedIn() && resource.data.toOwner == me();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['offer', 'kind', 'from', 'fromName', 'toOwner', 'toPlot', 'money', 'res', 'qty', 'createdAt'])
        && request.resource.data.from == me() && request.resource.data.createdAt == request.time
        && request.resource.data.money is number && request.resource.data.money >= 0 && request.resource.data.qty is int && request.resource.data.qty >= 0
        && dealOk(getAfter(/databases/$(database)/documents/worlds/$(worldId)/offers/$(request.resource.data.offer)).data, request.resource.data);
      allow delete: if signedIn() && resource.data.toOwner == me();
    }

    // City shares: a listed city's counter of shares for sale. Only its owner lists it (up to 490 of 1,000 shares);
    // buying and selling only move the counter, between none and what was listed; it can be closed once every share is back.
    match /worlds/{worldId}/stocks/{plotId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'city', 'float', 'available', 'createdAt'])
        && request.resource.data.owner == me() && get(docPath('plots', plotId)).data.owner == me()
        && request.resource.data.float is int && request.resource.data.float >= 50 && request.resource.data.float <= 490
        && request.resource.data.available == request.resource.data.float
        && request.resource.data.city is string && request.resource.data.city.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available'])
        && request.resource.data.available is int && request.resource.data.available >= 0 && request.resource.data.available <= resource.data.float;
      allow delete: if signedIn() && resource.data.owner == me() && resource.data.available == resource.data.float;
    }

    // Private messages between two players; the pair id is both uids, sorted, joined with _.
    match /dms/{pair}/messages/{msgId} {
      allow read: if signedIn() && me() in pair.split('_');
      allow create: if signedIn() && me() in pair.split('_') && pair.split('_').size() == 2
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt']) && request.resource.data.uid == me()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.uid == me();
    }
    // Each player's list of conversations. You keep your own; someone messaging you may only stamp their own line in yours, as unread.
    match /inbox/{uid}/threads/{other} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'last', 'at', 'unread'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.last is string && request.resource.data.last.size() <= 80
        && request.resource.data.unread is bool
        && (me() == uid || (me() == other && request.resource.data.unread == true && request.resource.data.at == request.time));
    }

    // The desk of a shared city: who is playing it now. Only its owner and co-mayors see or take it.
    match /desks/{plotId} {
      allow read: if signedIn() && runs(get(docPath('plots', plotId)).data);
      allow create, update: if signedIn() && runs(get(docPath('plots', plotId)).data)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at', 'idle'])
        && request.resource.data.uid == me() && request.resource.data.at == request.time
        && request.resource.data.idle is bool && request.resource.data.name is string && request.resource.data.name.size() <= 24;
      allow delete: if false;
    }

    // World chat. Rules on /worlds/{id} don't reach its subcollections, so chat needs its own block.
    match /worlds/{worldId}/chat/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'city', 'text', 'createdAt'])
        // Slow mode: the sender's chatLimits doc is stamped in the same write, at most once every 3 seconds.
        && getAfter(docPath('chatLimits', me())).data.at == request.time
        && request.resource.data.uid == me()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.city is string && request.resource.data.city.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
      // Reactions: anyone may set or clear only their own entry.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([me()])
        && (!(me() in request.resource.data.reactions) || request.resource.data.reactions[me()] in ['👍', '❤️', '😂', '🎉', '😮']);
    }
    match /chatLimits/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      allow update: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
        && request.time > resource.data.at + duration.value(3, 's');
    }

    // Guestbooks: one short note per visitor per city per day.
    match /worlds/{worldId}/guestbook/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['plot', 'uid', 'name', 'city', 'text', 'createdAt'])
        && request.resource.data.uid == me()
        && noteId.matches(request.resource.data.plot + '_' + me() + '_[0-9]+')
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin()
        || get(docPath('plots', resource.data.plot)).data.owner == me());
      allow update: if false;
    }

    // Regional projects: several mayors pay into one shared goal. Contributions only ever go up,
    // and a player can only add to their own line, by at most $2,000 at a time.
    match /worlds/{worldId}/projects/{projectId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type', 'name', 'goal', 'raised', 'by', 'byName', 'members', 'done', 'createdAt'])
        && request.resource.data.by == me() && request.resource.data.raised == 0 && request.resource.data.members == {}
        && request.resource.data.done == false && request.resource.data.goal is int && request.resource.data.goal >= 1000 && request.resource.data.goal <= 20000
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['raised', 'members', 'done'])
        && resource.data.done == false
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([me()])
        && request.resource.data.members[me()] is int
        && request.resource.data.members[me()] - resource.data.members.get(me(), 0) > 0
        && request.resource.data.members[me()] - resource.data.members.get(me(), 0) <= 2000
        && request.resource.data.raised == resource.data.raised + (request.resource.data.members[me()] - resource.data.members.get(me(), 0))
        && request.resource.data.done == (request.resource.data.raised >= resource.data.goal);
      allow delete: if signedIn() && (isAdmin() || (resource.data.by == me() && resource.data.raised == 0));
    }

    // Alliances: groups of mayors with a tag and their own chat. Players add or remove only themselves.
    match /worlds/{worldId}/alliances/{allianceId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'tag', 'owner', 'members', 'createdAt'])
        && request.resource.data.owner == me() && request.resource.data.members == [me()]
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.tag is string && request.resource.data.tag.matches('^[A-Z0-9]{2,4}$')
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.size() <= 12
        && request.resource.data.members.toSet().difference(resource.data.members.toSet()).union(resource.data.members.toSet().difference(request.resource.data.members.toSet())) == [me()].toSet();
      allow delete: if signedIn() && (isAdmin() || (resource.data.owner == me() && resource.data.members.size() <= 1));
    }
    match /worlds/{worldId}/alliances/{allianceId}/chat/{msgId} {
      allow read: if signedIn() && me() in get(/databases/$(database)/documents/worlds/$(worldId)/alliances/$(allianceId)).data.members;
      allow create: if signedIn() && me() in get(/databases/$(database)/documents/worlds/$(worldId)/alliances/$(allianceId)).data.members
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt']) && request.resource.data.uid == me()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
    }

    // Gifts between mayors. The giver writes; the receiver's game takes the money and deletes it.
    match /worlds/{worldId}/gifts/{giftId} {
      allow get: if signedIn() && (resource.data.toOwner == me() || resource.data.fromOwner == me());
      allow list: if signedIn() && resource.data.toOwner == me();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'fromOwner', 'to', 'toOwner', 'amount', 'note', 'createdAt'])
        && request.resource.data.fromOwner == me() && request.resource.data.toOwner != me()
        && get(docPath('plots', request.resource.data.from)).data.owner == me()
        && request.resource.data.amount is int && request.resource.data.amount >= 10 && request.resource.data.amount <= 1000
        && request.resource.data.note is string && request.resource.data.note.size() <= 120
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.toOwner == me();
      allow update: if false;
    }

    // Families moving between linked cities. The sender writes, the receiver reads and deletes.
    match /worlds/{worldId}/moves/{moveId} {
      allow get: if signedIn() && (resource.data.toOwner == me() || resource.data.fromOwner == me());
      allow list: if signedIn() && resource.data.toOwner == me();
      allow create: if signedIn()
        && request.resource.data.fromOwner == me()
        && request.resource.data.people is list && request.resource.data.people.size() <= 8
        && request.resource.data.keys().size() < 12;
      allow delete: if signedIn() && (resource.data.toOwner == me() || resource.data.fromOwner == me());
      allow update: if false;
    }

    // Lifetime stats and achievements. Private to each player.
    match /profiles/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid && request.resource.data.keys().size() < 20;
    }

    // Likes on cities: one per player per city.
    match /worlds/{worldId}/likes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me() && likeId == request.resource.data.plot + '_' + me()
        && request.resource.data.keys().hasOnly(['plot', 'uid', 'createdAt']);
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Feedback and support requests, for you to read in the console.
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.keys().size() < 16;
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note']);
    }

    // Chat reports, for you to review in the console.
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.uid == me() && request.resource.data.keys().size() < 10;
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note']);
    }

    // Admin list: only readable by admins themselves; created by hand in the console.
    match /admins/{uid} {
      allow get: if signedIn() && me() == uid;
      allow list, write: if false;
    }

    // Permanent records of fallen cities.
    match /legacy/{id} {
      allow read: if signedIn();
      // Only for a plot you own, and no longer-lived or bigger than that plot's last save (plus a little for the final hours).
      allow create: if signedIn() && request.resource.data.owner == me()
        && get(docPath('plots', request.resource.data.plotId)).data.owner == me()
        && request.resource.data.daysSurvived is number && request.resource.data.peakPop is number
        && request.resource.data.daysSurvived <= get(docPath('plots', request.resource.data.plotId)).data.get('day', 0) + 2
        && request.resource.data.peakPop <= get(docPath('plots', request.resource.data.plotId)).data.get('peakPop', 0) + 50;
      allow update, delete: if false;
    }
  }
}
